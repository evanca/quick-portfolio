---
import { Icon } from "astro-icon/components";
import { socialLinks } from "@/site.config";
---

<ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
	{
		socialLinks.map(({ friendlyName, link, name }) => (
			<li class="flex">
				<a
					class="text-muted hover:text-accent inline-flex items-center gap-1"
					href={link}
					rel={link.startsWith("http") ? "noreferrer" : undefined}
					target={link.startsWith("http") ? "_blank" : undefined}
				>
					<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name={name} />
					<span class="text-sm">{friendlyName}</span>
				</a>
			</li>
		))
	}
</ul>
